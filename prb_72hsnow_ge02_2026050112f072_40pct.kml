  <open>1</open>
  <snippet>Valid 12Z 05/01/2026 - 12Z 05/04/2026</snippet>
  <description></description>
    <Style id="poly_1">
        <IconStyle>
           <color>00000000</color>
           <scale>1</scale>
        </IconStyle>
        <LabelStyle>
            <color>ff26478b</color>
