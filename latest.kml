<name>WPC 72-Hr Prob of Snow > 2"</name>
  <open>1</open>
  <snippet>Valid 12Z 03/31/2026 - 12Z 04/03/2026</snippet>
  <description></description>
    <Style id="poly_1">
        <IconStyle>
           <color>00000000</color>
           <scale>1</scale>
