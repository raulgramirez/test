  <snippet>Valid 12Z 03/09/2026 - 12Z 03/12/2026</snippet>
  <description></description>
    <Style id="poly_1">
        <IconStyle>
           <color>00000000</color>
           <scale>1</scale>
        </IconStyle>
        <LabelStyle>
            <color>ff26478b</color>
