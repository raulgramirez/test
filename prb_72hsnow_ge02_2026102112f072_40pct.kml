	<PolyStyle>
            <color>6626478b</color>
	</PolyStyle>
        <BalloonStyle>
            <text>
                <![CDATA[ <table border=0 width="300"><tr><td style="font-size:10pt;">
                During this forecast period, there is a <b>1-5%</b> probability of snowfall exceeding the depicted amount in the enclosed area.
                <br/><br/>
                *<span style="font-size:8pt;">Note that in cases where this contour is embedded within a 5% contour, 
                the probability of snowfall exceeding the depicted amount is &lt;1%.</span>
                </td></tr></table>]]>
            </text>
        </BalloonStyle>
    </Style>

